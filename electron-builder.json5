{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "br.com.orizon.gestaooliveira",
  "productName": "Gestão Oliveira",
  "asar": true,
  "directories": {
    "output": "release/${version}"
  },
  "files": [
    "dist",
    "dist-electron"
  ],
  "win": {
    "icon": "public/icon.ico",
    "target": [
      {
        "target": "dir",
        "arch": ["x64"]
      }
    ],
    "executableName": "Gestao Oliveira"
  }
}
